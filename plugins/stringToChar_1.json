{"ID":0,"CreatedAt":"2026-03-01T15:20:25.6764007+08:00","UpdatedAt":"2026-03-01T15:20:25.6789411+08:00","DeletedAt":null,"script_name":"stringToChar","type":"codec","content":"# codec plugin\n\n/*\nCodec Plugin 可以支持在 Codec 中自定义编码解码，自定义 Bypass 与字符串处理函数\n\n函数定义非常简单\n\nfunc(i: string) string\n*/\n\nhandle = func(origin /*string*/) {\n    # handle your origin str\n\n    # input your yak code\n\n\n    rst = \"\"\n    for i = 0; i \u003c len(origin) ; i++ {\n        rst = rst + \"CHAR(\"+parseStr(origin[i])+\")+\" \n    }\n\n    rst = str.TrimRight(rst, \"+\")\n\n    return rst\n}\n","level":"","params":"\"null\"","help":"字符串拆分输出成char(int) 的形式","author":"10点睡觉的sucre","tags":"批量漏洞检测,协同办公套件","ignore":false,"from_local":false,"local_path":"","is_history":false,"force_interactive":false,"from_store":false,"is_general_module":false,"general_module_verbose":"","general_module_key":"","from_git":"","is_batch_script":false,"is_external":false,"enable_plugin_selector":false,"plugin_selector_types":"mitm,port-scan","online_id":5048,"online_script_name":"stringToChar","online_contributors":"","online_is_private":false,"user_id":12,"uuid":"327e4531-49b7-4a3c-9d33-ad07f075d033","head_img":"https://thirdwx.qlogo.cn/mmopen/vi_32/hBAhmch8vibenyCcu0wdjYNr4V8qr6aZj5epgaENWicEGJLEnegQyDT5MbxeBtyDGebcYfVUGfw9bn9f2AOvMlgxaSY3et1lLQ0IAVvPZvhSY/132","online_base_url":"https://www.yaklang.com","BaseOnlineId":0,"online_official":true,"online_group":"","is_core_plugin":false,"risk_type":"","risk_detail":"\"null\"","risk_annotation":"","collaborator_info":"","plugin_env_key":"","skip_update":false}