{"ID":0,"CreatedAt":"2026-03-01T15:20:14.4994663+08:00","UpdatedAt":"2026-03-01T15:20:14.4999784+08:00","DeletedAt":null,"script_name":"替换nbsp字符为正常空格字符","type":"codec","content":"# codec plugin\r\n\r\n/*\r\n从网页等地方复制代码时，空格可能变成了\u0026nbsp;字符（不间断空格0xa0、0xc2a0），这里将全部替换成正常的空格\r\n\r\nfunc(i: string) string\r\n*/\r\n\r\nhandle = func(origin /*string*/) {\r\n    origin = origin.ReplaceAll(\"\\xc2\\xa0\", \" \")\r\n    origin = origin.ReplaceAll(\"\\xa0\", \" \")\r\n    return origin\r\n}\r\n","level":"","params":"\"null\"","help":"从网页等地方复制代码时，空格可能变成了\u0026nbsp;字符（不间断空格0xa0、0xc2a0），这里将全部替换成正常的空格","author":"ViCrack","tags":"数据处理,allow-custom-context-menu-execute,allow-custom-http-packet-mutate","ignore":false,"from_local":false,"local_path":"","is_history":false,"force_interactive":false,"from_store":false,"is_general_module":false,"general_module_verbose":"","general_module_key":"","from_git":"","is_batch_script":false,"is_external":false,"enable_plugin_selector":false,"plugin_selector_types":"","online_id":27815,"online_script_name":"替换nbsp字符为正常空格字符","online_contributors":"","online_is_private":false,"user_id":4281,"uuid":"e772e356-d404-404e-8e26-17d61f4e165d","head_img":"https://avatars.githubusercontent.com/u/18179821?v=4","online_base_url":"https://www.yaklang.com","BaseOnlineId":0,"online_official":false,"online_group":"","is_core_plugin":false,"risk_type":"","risk_detail":"\"null\"","risk_annotation":"","collaborator_info":"","plugin_env_key":"","skip_update":false}