{"ID":0,"CreatedAt":"2026-03-01T15:20:04.8737815+08:00","UpdatedAt":"2026-03-01T15:20:04.8745543+08:00","DeletedAt":null,"script_name":"H4sl解码","type":"codec","content":"# codec plugin\r\n\r\n/*\r\nCodec Plugin 可以支持在 Codec 中自定义编码解码，自定义 Bypass 与字符串处理函数\r\n\r\n函数定义非常简单\r\n\r\nfunc(i: string) string\r\n*/\r\n\r\nhandle = func(origin /*string*/) {\r\n    url_decode := codec.UnescapePathUrl(origin)~\r\n    base64_decode := codec.DecodeBase64(url_decode)~\r\n    gzip_decompress := string(gzip.Decompress(string(base64_decode))~)\r\n    return gzip_decompress\r\n}\r\n","level":"","params":"\"null\"","help":"解码H4sl，常用于app","author":"元仁昊","tags":"加解密工具,allow-custom-http-packet-mutate,allow-custom-context-menu-execute,allow-custom-single-history-mutate","ignore":false,"from_local":false,"local_path":"","is_history":false,"force_interactive":false,"from_store":false,"is_general_module":false,"general_module_verbose":"","general_module_key":"","from_git":"","is_batch_script":false,"is_external":false,"enable_plugin_selector":false,"plugin_selector_types":"","online_id":35043,"online_script_name":"H4sl解码","online_contributors":"","online_is_private":false,"user_id":21756,"uuid":"07c56727-a675-411e-86d3-b976d5c61249","head_img":"https://thirdwx.qlogo.cn/mmopen/vi_32/h1YZmibp76ezghgxAWv7iauhiaqTmW6rU3KlbKbeLicZgsjB0FcqzdJn4B3jBicRWZmibXosKjF7Av9qKuiaicuicpw3eK2kSiaxeVawzk0ELkKszsQaw/132","online_base_url":"https://www.yaklang.com","BaseOnlineId":0,"online_official":false,"online_group":"","is_core_plugin":false,"risk_type":"","risk_detail":"\"null\"","risk_annotation":"","collaborator_info":"","plugin_env_key":"","skip_update":false}