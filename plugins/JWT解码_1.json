{"ID":0,"CreatedAt":"2026-03-01T15:20:09.6156104+08:00","UpdatedAt":"2026-03-01T15:20:09.6161252+08:00","DeletedAt":null,"script_name":"JWT解码","type":"codec","content":"# codec plugin\r\n\r\n/*\r\nCodec Plugin 可以支持在 Codec 中自定义编码解码，自定义 Bypass 与字符串处理函数\r\n\r\n函数定义非常简单\r\n\r\nfunc(i: string) string\r\n*/\r\n\r\nhandle = func(origin /*string*/) {\r\n    # handle your origin str\r\n    end=\"\"\r\n    three=str.Split(origin, \".\")\r\n\r\n    for i in three[:-1]{\r\n        chars=string(codec.DecodeBase64Url(i)~)\r\n        end += chars+'\\n\\n'  \r\n    }\r\n    end += three[-1]\r\n\r\n    return end\r\n}\r\n","level":"","params":"\"null\"","help":"用原始的方法将jwt进行base64url解码，保留原始的键值顺序","author":"TAI","tags":"allow-custom-context-menu-execute,jwt","ignore":false,"from_local":false,"local_path":"","is_history":false,"force_interactive":false,"from_store":false,"is_general_module":false,"general_module_verbose":"","general_module_key":"","from_git":"","is_batch_script":false,"is_external":false,"enable_plugin_selector":false,"plugin_selector_types":"","online_id":31717,"online_script_name":"JWT解码","online_contributors":"","online_is_private":false,"user_id":8994,"uuid":"9eb059ca-fa18-45b4-8e05-776601c655fe","head_img":"https://thirdwx.qlogo.cn/mmopen/vi_32/PiajxSqBRaEKKFkc8PQfGR55TlzWeVSm5qdrWnzibZoky8kgiatqLHpo7ExlfCQUD3yzccmz1rnYyUn7BeDc8bveXqGC0tC0fkicHAsWy9m0FMnCrZDiaWiaKB7Q/132","online_base_url":"https://www.yaklang.com","BaseOnlineId":0,"online_official":false,"online_group":"","is_core_plugin":false,"risk_type":"","risk_detail":"\"null\"","risk_annotation":"","collaborator_info":"","plugin_env_key":"","skip_update":false}