{"ID":0,"CreatedAt":"2026-03-01T15:20:36.164152+08:00","UpdatedAt":"2026-03-01T15:20:36.164152+08:00","DeletedAt":null,"script_name":"按行打乱","type":"codec","content":"# codec plugin\r\n\r\n/*\r\nCodec Plugin 可以支持在 Codec 中自定义编码解码，自定义 Bypass 与字符串处理函数\r\n\r\n函数定义非常简单\r\n\r\nfunc(i: string) string\r\n*/\r\n\r\nhandle = func(origin /*string*/) {\r\n    # handle your origin str\r\n    slice := str.Split(origin, \"\\n\")\r\n    for i := range slice {\r\n        j := randn(0,i + 1)\r\n        slice[i], slice[j] = slice[j], slice[i]\r\n    }\r\n    return str.Join(str.Split(str.Join(str.Split(str.Join(slice,\"\\n\"),\"\\r\\n\"), \"\\n\") ,\"\\n\\n\"), \"\\n\")\r\n}\r\n","level":"","params":"\"null\"","help":"按行打乱数据","author":"桔子爱吃橘子","tags":"加解密工具,功能类型","ignore":false,"from_local":false,"local_path":"","is_history":false,"force_interactive":false,"from_store":false,"is_general_module":false,"general_module_verbose":"","general_module_key":"","from_git":"","is_batch_script":false,"is_external":false,"enable_plugin_selector":false,"plugin_selector_types":"","online_id":4132,"online_script_name":"按行打乱","online_contributors":"","online_is_private":false,"user_id":3,"uuid":"b11a348e-d183-4034-a3d4-adc2ad2fe221","head_img":"https://thirdwx.qlogo.cn/mmopen/vi_32/Q0j4TwGTfTLcAuT7b2J3eBGHCQaPicMicGFiaaksYOtjBDNKYUtK3l3TRlAk5xWyKBWQx5BxSZjHGCGDcibwo4pBdw/132","online_base_url":"https://www.yaklang.com","BaseOnlineId":0,"online_official":true,"online_group":"","is_core_plugin":false,"risk_type":"","risk_detail":"\"null\"","risk_annotation":"","collaborator_info":"","plugin_env_key":"","skip_update":false}