{"ID":0,"CreatedAt":"2026-03-01T15:20:11.474299+08:00","UpdatedAt":"2026-03-01T15:20:11.4777772+08:00","DeletedAt":null,"script_name":"取消标记流量","type":"codec","content":"# codec plugin\r\n\r\n/*\r\nCodec Plugin 可以支持在 Codec 中自定义编码解码，自定义 Bypass 与字符串处理函数\r\n\r\n函数定义非常简单\r\n\r\nfunc(i: string) string\r\n*/\r\n\r\nhandle = func(origin /*string*/) {\r\n    httpflows = db.QueryHTTPFlowsByID(int(origin))\r\n    for httpflow  = range httpflows{\r\n        httpflow.Tags = \"\"\r\n        httpflow.RemoveColor()\r\n        db.SaveHTTPFlowInstance(httpflow)\r\n    }\r\n    return origin\r\n}","level":"","params":"\"null\"","help":"取消被标记的流量","author":"Yzenith.","tags":"allow-custom-single-history-mutate","ignore":false,"from_local":false,"local_path":"","is_history":false,"force_interactive":false,"from_store":false,"is_general_module":false,"general_module_verbose":"","general_module_key":"","from_git":"","is_batch_script":false,"is_external":false,"enable_plugin_selector":false,"plugin_selector_types":"","online_id":30062,"online_script_name":"取消标记流量","online_contributors":"","online_is_private":false,"user_id":53,"uuid":"bfe90dfb-efa4-491e-bc98-7c63c6d98aee","head_img":"https://thirdwx.qlogo.cn/mmopen/vi_32/9FvfglcsAUia1nTlsIhrHB9GrkgwAia2X5QjrY7oEO0OlHXTvFBmu1A8dyYeVDeNEHhsLd96Nhak1uyFCsJZHUCAvjQiaBicWomzqyeAQlb4bWc/132","online_base_url":"https://www.yaklang.com","BaseOnlineId":0,"online_official":false,"online_group":"","is_core_plugin":false,"risk_type":"","risk_detail":"\"null\"","risk_annotation":"","collaborator_info":"","plugin_env_key":"","skip_update":false}