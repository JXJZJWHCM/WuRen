[
  {
    "name": "java_Hardcoded_Credentials",
    "Severity": "CRITICAL",
    "Description": "Detects hardcoded credentials such as passwords, API keys, and secret tokens in Java code.",
    "patterns": [
      "\"[^\"]*[Pp]assword[^\"]*\"\\s*=",
      "\"[^\"]*[Aa][Pp][Ii][Kk]ey[^\"]*\"\\s*=",
      "\"[^\"]*[Ss]ecret[^\"]*\"\\s*=",
      "\"[^\"]*[Tt]oken[^\"]*\"\\s*=",
      "\"[^\"]*sk_live_[^\"]*\"",
      "\"[^\"]*eyJ[^\"]*\"",
      "\"[^\"]*admin[^\"]*\"\\s*="
    ],
    "sources": [],
    "sinks": []
  }
]
