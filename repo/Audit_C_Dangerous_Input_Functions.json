  "RuleName": "审计C语言中的危险输入函数",
  "Title": "Audit C Dangerous Input Functions",
  "TitleZh": "审计C语言中的危险输入函数",
  "Language": "c",
  "Purpose": "audit",
  "Tag": "c|CWE-120|buffer-copy-without-checking",
