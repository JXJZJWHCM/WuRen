[
  {
    "name": "php_Hardcoded_Credentials",
    "Severity": "CRITICAL",
    "Description": "Detects hardcoded credentials such as usernames, passwords, or secrets in PHP source code.",
    "patterns": [
      "(?i)\\$\\s*(username|user)\\s*=\\s*['\"][^'\"]*['\"]\\s*;",
      "(?i)\\$\\s*(password|pass|pwd)\\s*=\\s*['\"][^'\"]*['\"]\\s*;",
      "(?i)\\$\\s*(secret|key|token)\\s*=\\s*['\"][^'\"]*['\"]\\s*;"
    ],
    "sources": [],
    "sinks": []
  }
]
