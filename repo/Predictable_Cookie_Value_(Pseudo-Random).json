  "hash": "d80374bd1afc9524e57ecd9c26a75d6cf555fd339df61c2c637ae821e109f7c0",
  "RuleName": "可预测的Cookie值（伪随机）",
  "Title": "Predictable Cookie Value (Pseudo-Random)",
  "TitleZh": "可预测的Cookie值（伪随机）",
  "Language": "php",
  "Purpose": "audit",
  "Tag": "php|php-code-style",
  "cwe": [
    "CWE-330",
